# Kernel options on top of arch/arm/configs/sunxi_defconfig.
# First milestone: boot to a shell on the UART (ttyS3) and on the USB serial gadget (ttyGS0).

# Console
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# USB: OTG controller in peripheral mode with a built-in serial gadget (no module loading needed)
CONFIG_USB_SUPPORT=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y

# Root file system
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
