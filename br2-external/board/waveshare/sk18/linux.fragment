# Kernel options on top of arch/arm/configs/sunxi_defconfig.
# First milestone: boot to a shell on the UART (ttyS3) and on the USB serial gadget (ttyGS0).

# Console
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# USB: OTG controller in peripheral mode with a built-in serial gadget (no module loading needed)
CONFIG_USB_SUPPORT=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y

# Display: DE2 mixer, TCON, MIPI-DSI and D-PHY (on by default with DRM_SUN4I), the panel driver
# (HX8394 plus the SK-18 entry) comes from patches/linux/0001, the backlight is a software PWM on PG10 for now.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_HIMAX_HX8394=y
CONFIG_PWM=y
CONFIG_PWM_GPIO=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# Touch/keys most likely arrive over UART1 (see D-022); the 8250 driver for it is already on.
CONFIG_INPUT_EVDEV=y

# Text console on the screen (the panel is portrait; fbcon=rotate on the command line turns it)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_10x18=y

# Root file system
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Wi-Fi: RTL8188GU USB adapter (0bda:b711 after the mode switch) through the in-kernel rtl8xxxu driver. Built in:
# the firmware is read from the root file system when the adapter appears, which is after the root is mounted.
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RFKILL=y
CONFIG_PACKET=y
# udev (eudev) needs these (devtmpfs is enabled above)
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_EPOLL=y
