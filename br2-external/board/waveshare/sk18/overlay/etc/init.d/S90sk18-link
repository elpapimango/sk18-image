#!/bin/sh
# The deck link to controldeck (sk18-link). It starts only after the boot animation has finished, so that a first
# picture from the host cannot overwrite the animation. Its log is /tmp/sk18-link.log (the file is gone after a
# reboot); it reconnects by itself when the host goes away.
DAEMON=/usr/bin/sk18-link
LOG=/tmp/sk18-link.log

case "$1" in
	start)
		# two daemons on the port would split the host's data between them and corrupt every frame
		pidof sk18-link > /dev/null && exit 0
		(
			i=0
			while pidof sk18-splash > /dev/null && [ "$i" -lt 100 ]; do
				sleep 0.2
				i=$((i + 1))
			done
			exec "$DAEMON" --verbose >> "$LOG" 2>&1
		) > /dev/null 2>&1 &
		;;
	stop)
		killall sk18-link 2> /dev/null
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
exit 0
