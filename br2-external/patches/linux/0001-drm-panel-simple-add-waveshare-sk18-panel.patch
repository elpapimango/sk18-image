From: SK-18 project <noreply@example.invalid>
Subject: [PATCH] drm/panel: simple: Add Waveshare SK-18 panel

Add the 5 inch 720x1280 two-lane MIPI-DSI panel of the Waveshare SK-18
(Allwinner T113-S3). The timing is converted from the vendor device tree:
70 MHz pixel clock, 900 x 1312 total, hsync 20, vsync 4. The vendor driver
sends no DSI commands, so the panel is described like the other video-mode
panels in panel-simple. The physical size is an estimate.

---
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -6387,6 +6387,43 @@
 	.lanes = 4,
 };
 
+static const struct drm_display_mode waveshare_sk18_panel_mode = {
+	.clock = 70000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 80,
+	.hsync_end = 720 + 80 + 20,
+	.htotal = 720 + 80 + 20 + 80,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 16,
+	.vsync_end = 1280 + 16 + 4,
+	.vtotal = 1280 + 16 + 4 + 12,
+};
+
+/*
+ * Panel of the Waveshare SK-18 (5 inch, 720x1280, 2 lane MIPI-DSI, video mode). The timing is
+ * converted from the vendor device tree (70 MHz, 900 x 1312 total); the vendor driver sends no
+ * DSI commands. The physical size is an estimate for a 5 inch portrait panel.
+ */
+static const struct panel_desc_dsi waveshare_sk18_panel = {
+	.desc = {
+		.modes = &waveshare_sk18_panel_mode,
+		.num_modes = 1,
+		.bpc = 8,
+		.size = {
+			.width = 62,
+			.height = 110,
+		},
+		.delay = {
+			.prepare = 80,
+			.enable = 100,
+		},
+		.connector_type = DRM_MODE_CONNECTOR_DSI,
+	},
+	.flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 2,
+};
+
 static const struct drm_display_mode panasonic_vvx10f004b00_mode = {
 	.clock = 157200,
 	.hdisplay = 1920,
@@ -6519,6 +6556,9 @@
 		.compatible = "lg,lh500wx1-sd03",
 		.data = &lg_lh500wx1_sd03
 	}, {
+		.compatible = "waveshare,sk18-panel",
+		.data = &waveshare_sk18_panel
+	}, {
 		.compatible = "panasonic,vvx10f004b00",
 		.data = &panasonic_vvx10f004b00
 	}, {
--- a/Documentation/devicetree/bindings/display/panel/panel-simple-dsi.yaml
+++ b/Documentation/devicetree/bindings/display/panel/panel-simple-dsi.yaml
@@ -65,6 +65,7 @@
       - tdo,tl070wsh30
         # Team Source Display Technology 7" TST070WSBE-196C 1024x600 TFT LCD panel
       - team-source-display,tst070wsbe-196c
+      - waveshare,sk18-panel
 
   reg:
     maxItems: 1
