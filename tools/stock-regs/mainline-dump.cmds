dumpr() { b=$(($1)); n=$(($2)); o=0; while [ $o -lt $n ]; do l=$(printf "0x%08x:" $((b+o))); k=0; while [ $k -lt 16 ]; do v=$(devmem $((b+o+k))); l="$l $(printf '%08x' $v)"; k=$((k+4)); done; echo "$l"; o=$((o+16)); done; }
g=$(devmem 0x02001b4c); echo "bus-mipi-dsi gate/reset register: $g"
( devmem 0x02001b4c 32 $(( $(devmem 0x02001b4c) | 1 )); echo "## DSI 0x05450000"; dumpr 0x05450000 0x1000; echo "## D-PHY 0x05451000"; dumpr 0x05451000 0x1000; echo "## TCON TOP 0x05460000"; dumpr 0x05460000 0x100; echo "## TCON LCD0 0x05461000"; dumpr 0x05461000 0x1000; echo "## DE top 0x05000000"; dumpr 0x05000000 0x100; echo "## mixer0 global 0x05100000"; dumpr 0x05100000 0x100; echo "## mixer0 blender 0x05101000"; dumpr 0x05101000 0x100; echo "## mixer0 VI channel 0 0x05102000"; dumpr 0x05102000 0x100; echo "## mixer0 UI channel 0 0x05103000"; dumpr 0x05103000 0x100; echo "## CCU 0x02001000"; dumpr 0x02001000 0x1000; echo "## PIO 0x02000000"; dumpr 0x02000000 0x400; devmem 0x02001b4c 32 $(( $(devmem 0x02001b4c) & ~1 )); echo "# DONE" ) > /tmp/regs_mainline.txt 2>&1 & true
